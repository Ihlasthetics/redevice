{
  "name": "redevice",
  "private": true,
  "version": "0.0.0",
  "description": "Verifiable repair histories for refurbished electronics on Stellar",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @redevice/web",
    "build": "npm run build --workspace @redevice/web",
    "typecheck": "npm run typecheck --workspace @redevice/web",
    "format:check": "npm run format:check --workspace @redevice/web",
    "test": "npm run test --workspace @redevice/web",
    "test:fee-bump": "node --test scripts/build-upload-fee-bump.test.mjs",
    "testnet:preflight": "node scripts/check-testnet-upload.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@openzeppelin/relayer-plugin-channels": "0.21.0"
  }
}
